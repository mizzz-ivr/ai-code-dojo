{
  "name": "ai-code-dojo",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo foundation for AI-generated code learning platform",
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test:unit": "node --test tests/unit/**/*.test.mjs",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "schema:validate": "node scripts/validate-problems.mjs",
    "infra:validate": "node scripts/validate-sqs-cloudformation.mjs",
    "build": "node scripts/build.mjs",
    "dev:api": "node apps/api/src/server.mjs",
    "dev:worker": "node apps/worker/src/server.mjs",
    "dev:web": "node apps/web/src/server.mjs",
    "test:smoke": "node --test tests/smoke/**/*.test.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1093.0"
  },
  "packageManager": "pnpm@10.13.1"
}
